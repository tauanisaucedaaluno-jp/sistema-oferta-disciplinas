# Copie este arquivo para ".env" (mesma pasta) e ajuste se precisar.
# ".env" nunca deve ser commitado — já está no .gitignore.

DATABASE_URL=postgresql+psycopg2://oferta:oferta_dev_local@localhost:5432/oferta_disciplinas

# Chave usada para assinar os tokens JWT de login (RF13).
# Gere uma chave real com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao

ACCESS_TOKEN_EXPIRE_MINUTES=30
